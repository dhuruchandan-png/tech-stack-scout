# Neon pooled connection string
DATABASE_URL=

# Gemini (all AI tasks use Gemini Flash only)
GEMINI_API_KEY=
# Optional. Leave unset to use the rolling alias; the app falls back across Flash versions.
GEMINI_MODEL=gemini-flash-latest

# Fine-grained token, public read only
GITHUB_TOKEN=
YOUTUBE_API_KEY=

# Scopes: crm.objects.companies read/write, crm.objects.contacts read,
# crm.schemas.companies write, notes + emails write
HUBSPOT_PRIVATE_APP_TOKEN=

RESEND_API_KEY=
EMAIL_FROM="Tech Stack Scout <onboarding@resend.dev>"
# Internal sends are allowed only to this domain or the settings allowlist
INTERNAL_EMAIL_DOMAIN=
NIKHIL_EMAIL=
EMAIL_TEST_MODE=true
TEST_EMAIL=

# Optional. If set, the two cron endpoints require "Authorization: Bearer <value>" (Vercel adds it automatically).
CRON_SECRET=
APP_BASE_URL=http://localhost:3000
